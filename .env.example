# Copy these names into a private shell file, for example:
#   ~/.config/roughcut/env.sh
# Then load it before running the benchmark:
#   source ~/.config/roughcut/env.sh
# Multiple API keys may be supplied as a comma-separated list.

# Dataset and generated-output roots. If omitted, the repository-local
# data/ and outputs/ directories are used.
export ROUGHCUT_DATA_ROOT=""
export ROUGHCUT_OUTPUT_ROOT=""

# Optional per-set overrides.
export ROUGHCUT_SET1_MEDIA=""
export ROUGHCUT_SET1_LABELS=""
export ROUGHCUT_SET2_MEDIA=""
export ROUGHCUT_SET2_LABELS=""
export ROUGHCUT_SPEECH_DATA_ROOT=""
export ROUGHCUT_SPEECH_OUTPUT_ROOT=""

# Official provider credentials. Set only the providers you use.
export GEMINI_API_KEY=""
export OPENAI_API_KEY=""
export DASHSCOPE_API_KEY=""
export ZAI_API_KEY=""
export ARK_API_KEY=""

# Optional provider base-URL overrides. The code uses official public URLs when
# these values are empty. DashScope workspace domains can be configured here.
export GEMINI_BASE_URL=""
export OPENAI_BASE_URL=""
export DASHSCOPE_BASE_URL=""
export ZAI_BASE_URL=""
export ARK_BASE_URL=""

# Optional model-ID overrides. These are useful when a dated model is no longer
# available or when a provider requires an endpoint/deployment ID. The
# paper-facing gemini-3-pro alias defaults to gemini-3.1-pro-preview because the
# original gemini-3-pro-preview endpoint has been retired.
export ROUGHCUT_GEMINI_2_5_PRO_MODEL_ID=""
export ROUGHCUT_GEMINI_3_PRO_MODEL_ID=""
export ROUGHCUT_GPT_5_4_MODEL_ID=""
export ROUGHCUT_GPT_5_5_MODEL_ID=""
export ROUGHCUT_QWEN_3_5_PLUS_MODEL_ID=""
export ROUGHCUT_QWEN_3_7_PLUS_MODEL_ID=""
export ROUGHCUT_GLM_5V_TURBO_MODEL_ID=""
export ROUGHCUT_SEED_2_0_LITE_MODEL_ID=""

# Optional request timeout shared by all providers.
export ROUGHCUT_API_TIMEOUT_SECONDS="360"

# The evaluator uses the same model registry and provider credentials.
export VISUAL_EVAL_LLM_MODEL="gemini-3-pro"
