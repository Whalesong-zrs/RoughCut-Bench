{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whalesong-zrs.github.io/RoughCut-Bench-Project-Page/schemas/visual_cut_plan.schema.json",
  "title": "RoughCut-Bench Visual Cut Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "ordered_videos"],
  "properties": {
    "schema_version": {
      "const": "roughcut-bench-cut-plan-v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "ordered_videos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "segments"],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/\\\\]+$"
          },
          "segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start_time", "end_time"],
              "properties": {
                "start_time": {
                  "type": "number",
                  "minimum": 0
                },
                "end_time": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
